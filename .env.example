# Copia a .env.local y completa con los datos de tu proyecto Firebase (consola > Configuración del proyecto).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# En desarrollo local con emuladores (npm run emulators):
# VITE_USE_EMULATORS=true

# Correos de estado (aprobada / en observación / rechazada) con EmailJS. Ver docs/firebase-setup.md.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
# Correo de contacto que aparece en los mensajes y como «responder a» (opcional).
VITE_CONTACT_EMAIL=
