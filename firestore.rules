rules_version = '2';

// Data League 2026. Ver SRS.md, secciones 3, 5 y 6.2.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Administración: solo la cuenta de correo/contraseña creada a mano en Firebase Authentication.
    // Una cuenta de Google con ese correo no sirve: se exige el proveedor «password».
    function isAdmin() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email == 'admin@dataleague.test';
    }

    // Cierre: 29/11/2026 23:59:59 hora de Perú (UTC-5) = 30/11/2026 04:59:59 UTC.
    function beforeDeadline() { return request.time < timestamp.date(2026, 11, 30) + duration.value(5, 'h'); }
    function applicationsOpen() {
      let cfg = /databases/$(database)/documents/config/2026-uni;
      return !exists(cfg) || get(cfg).data.get('postulacionAbierta', true) == true;
    }
    function emailRe(v) { return v is string && v.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') && v.size() <= 120; }
    function phoneRe(v) { return v is string && v.matches('^\\+[1-9][0-9]{7,14}$'); }
    function text(v, max) { return v is string && v.trim().size() > 0 && v.size() <= max; }

    function validMember(m) {
      return m is map
        && m.keys().hasOnly(['nombre', 'correo', 'whatsapp'])
        && text(m.nombre, 100)
        && emailRe(m.correo) && m.correo == m.correo.lower()
        && phoneRe(m.whatsapp);
    }

    // Nadie repite correo: ni los integrantes entre sí ni con quien lidera (RN-06).
    function distinctEmails(d) {
      let m = d.integrantes;
      let n = m.size();
      return (n < 1 || m[0].correo != d.correo)
        && (n < 2 || (m[1].correo != d.correo && m[1].correo != m[0].correo))
        && (n < 3 || (m[2].correo != d.correo && m[2].correo != m[0].correo && m[2].correo != m[1].correo));
    }

    // Postulación mínima: nombre, celular y correo de cada persona, más la aceptación de datos y bases.
    function validPostulacion(d) {
      return d.keys().hasOnly(['edicion', 'uid', 'modo', 'estado', 'nombre', 'whatsapp', 'correo', 'nombreEquipo', 'integrantes', 'consentimiento', 'versionTextosLegales', 'creadoEn', 'actualizadoEn'])
        && d.edicion == '2026-uni'
        && d.uid == request.auth.uid
        && d.modo in ['equipo', 'individual']
        && text(d.nombre, 100)
        && phoneRe(d.whatsapp)
        && emailRe(d.correo) && d.correo == request.auth.token.email.lower()
        && d.consentimiento == true
        && text(d.versionTextosLegales, 20)
        && (
          (d.modo == 'equipo'
            && text(d.nombreEquipo, 60)
            && d.integrantes is list && d.integrantes.size() >= 1 && d.integrantes.size() <= 3   // equipo de 2 a 4 con quien lidera
            && distinctEmails(d))
          ||
          (d.modo == 'individual' && !('integrantes' in d) && !('nombreEquipo' in d))
        );
    }

    // Una postulación nueva completa (alta, o nueva postulación tras haber retirado la anterior).
    function validNueva(d, uid) {
      return beforeDeadline() && applicationsOpen()
        && validPostulacion(d)
        && d.estado == 'registrada'
        && d.creadoEn == request.time
        && d.actualizadoEn == request.time
        && (d.modo == 'individual'
            || d.integrantes.size() == 0
            || validMember(d.integrantes[0]))
        && (d.modo == 'individual'
            || d.integrantes.size() < 2
            || validMember(d.integrantes[1]))
        && (d.modo == 'individual'
            || d.integrantes.size() < 3
            || validMember(d.integrantes[2]));
    }

    // ---------- Postulaciones: el id es el uid de quien postula (una por cuenta) ----------
    match /postulaciones/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if signedIn() && request.auth.uid == uid && validNueva(request.resource.data, uid);

      // Quien retiró su postulación puede volver a postular mientras siga abierto el plazo: se reemplaza por una nueva.
      allow update: if signedIn() && request.auth.uid == uid && resource.data.estado == 'retirada'
        && validNueva(request.resource.data, uid);

      // El postulante solo puede retirar su postulación (la edición completa llega en la fase 3).
      allow update: if signedIn() && request.auth.uid == uid && beforeDeadline()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'actualizadoEn'])
        && request.resource.data.estado == 'retirada'
        && request.resource.data.actualizadoEn == request.time;

      allow update, delete: if isAdmin();
    }

    // Entrada del índice de correos: solo para correos de la postulación que se guarda en el mismo lote.
    function validIndice(id) {
      return signedIn() && beforeDeadline() && applicationsOpen()
        && request.resource.data.keys().hasOnly(['uid', 'rol'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.rol in ['lider', 'individual', 'integrante']
        && id.matches('^2026-uni_.+$')
        && (
          id == '2026-uni_' + getAfter(/databases/$(database)/documents/postulaciones/$(request.auth.uid)).data.correo
          || (getAfter(/databases/$(database)/documents/postulaciones/$(request.auth.uid)).data.get('integrantes', []).size() > 0
              && id == '2026-uni_' + getAfter(/databases/$(database)/documents/postulaciones/$(request.auth.uid)).data.integrantes[0].correo)
          || (getAfter(/databases/$(database)/documents/postulaciones/$(request.auth.uid)).data.get('integrantes', []).size() > 1
              && id == '2026-uni_' + getAfter(/databases/$(database)/documents/postulaciones/$(request.auth.uid)).data.integrantes[1].correo)
          || (getAfter(/databases/$(database)/documents/postulaciones/$(request.auth.uid)).data.get('integrantes', []).size() > 2
              && id == '2026-uni_' + getAfter(/databases/$(database)/documents/postulaciones/$(request.auth.uid)).data.integrantes[2].correo)
        );
    }

    // ---------- Índice de unicidad de correos (RN-06) ----------
    // Se crea en la misma transacción que la postulación y solo para correos que ella contiene.
    match /correosEdicion/{id} {
      allow get: if signedIn();      // el cliente comprueba si el correo ya está inscrito
      allow list: if isAdmin();
      allow create: if validIndice(id);
      // Una postulación retirada antes de existir la liberación de correos dejó su entrada: la misma persona la reutiliza.
      allow update: if resource.data.uid == request.auth.uid && validIndice(id);
      // Al retirar su postulación, la persona libera los correos de su equipo para poder volver a postular.
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/postulaciones/$(request.auth.uid)).data.estado == 'retirada';
      allow update, delete: if isAdmin();
    }

    match /config/{edicion} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- Sponsors: cualquiera puede enviar una solicitud; solo los admins la leen y la gestionan ----------
    function validSponsor(d) {
      return d.keys().hasOnly(['edicion', 'organizacion', 'contacto', 'cargo', 'correo', 'telefono', 'tipoApoyo', 'mensaje', 'consentimientoDatos', 'estado', 'creadoEn'])
        && d.edicion == '2026-uni' && d.estado == 'nuevo'
        && text(d.organizacion, 120) && text(d.contacto, 100) && text(d.cargo, 80)
        && emailRe(d.correo)
        && d.telefono is string && d.telefono.size() <= 20
        && d.tipoApoyo is list && d.tipoApoyo.size() >= 1 && d.tipoApoyo.size() <= 5
        && d.tipoApoyo.hasOnly(['economico', 'premios', 'difusion', 'mentoria', 'otro'])
        && d.mensaje is string && d.mensaje.size() <= 1000
        && d.consentimientoDatos == true
        && d.creadoEn == request.time;
    }
    match /sponsors/{id} {
      allow create: if validSponsor(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // ---------- Mentores: cualquiera puede enviar una postulación; solo los admins la leen y la gestionan ----------
    function validMentor(d) {
      return d.keys().hasOnly(['edicion', 'nombre', 'correo', 'telefono', 'ocupacion', 'perfil', 'areas', 'mensaje', 'consentimientoDatos', 'estado', 'creadoEn'])
        && d.edicion == '2026-uni' && d.estado == 'nuevo'
        && text(d.nombre, 100) && text(d.ocupacion, 120)
        && emailRe(d.correo)
        && d.telefono is string && d.telefono.size() <= 20
        && d.perfil is string && d.perfil.size() <= 200
        && d.areas is list && d.areas.size() >= 1 && d.areas.size() <= 6
        && d.areas.hasOnly(['storytelling', 'ml', 'ia', 'gobierno', 'negocio', 'otro'])
        && d.mensaje is string && d.mensaje.size() <= 1000
        && d.consentimientoDatos == true
        && d.creadoEn == request.time;
    }
    match /mentores/{id} {
      allow create: if validMentor(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // ---------- Inscripciones a las jornadas virtuales: id = {evento}_{uid}; cada persona gestiona solo la suya ----------
    match /inscripciones/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['evento', 'uid', 'nombre', 'correo', 'creadoEn'])
        && request.resource.data.evento in ['kickoff', 'ml', 'ia', 'gobierno']
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.evento + '_' + request.auth.uid
        && text(request.resource.data.nombre, 100)
        && request.resource.data.correo == request.auth.token.email.lower()
        && request.resource.data.creadoEn == request.time;
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }

    match /notasAdmin/{id} {
      allow read, write: if isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
