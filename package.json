{
  "name": "data-league-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --only auth,firestore",
    "test:form": "tsx --test tests/postulacion.test.ts",
    "test:rules": "firebase emulators:exec --only firestore \"tsx --test tests/rules.test.ts\"",
    "deploy:rules": "firebase deploy --only firestore:rules --project prod",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules --project prod"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.3",
    "firebase": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "^8.5.1",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@fontsource-variable/anybody": "^5.3.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/alfa-slab-one": "^5.3.0",
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/gloock": "^5.3.0",
    "@fontsource/graduate": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "firebase-tools": "^15.35.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
